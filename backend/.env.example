# backend/.env.example
# This backend now runs as a single Python process with in-memory realtime,
# rate-limit, refresh-token, word-cache, and game-state stores.
# No Redis, Celery, Docker Compose, or cache infrastructure is required.
APP_NAME="Codenames India API"
APP_ENV=production
DEBUG=false
API_PREFIX=/api
SECRET_KEY=change-me-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_MINUTES=30
ALLOWED_ORIGINS=https://code-names-theta.vercel.app,http://localhost:5173
ALLOWED_ORIGIN_REGEX=
# On IPv4-only hosts like Render, use the Supabase session pooler,
# for example: postgresql+asyncpg://postgres.<project-ref>:password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql+asyncpg://postgres:password@db.your-project.supabase.co:5432/postgres?sslmode=require
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_REDIRECT_URL=https://your-domain.example/api/auth/google/callback
FRONTEND_URL=https://code-names-theta.vercel.app
AVATARS_BUCKET=avatars
WORD_PACKS_BUCKET=word_packs
COOKIE_SECURE=true
COOKIE_DOMAIN=
COOKIE_SAMESITE=none
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
WS_HEARTBEAT_SECONDS=30
WS_DEAD_SECONDS=90
ROOM_RECONNECT_GRACE_SECONDS=30
DEFAULT_TURN_SECONDS=90
LOG_LEVEL=INFO
