# backend/.env.example
APP_NAME="Codenames India API"
APP_ENV=production
DEBUG=false
API_PREFIX=/api
SECRET_KEY=change-me-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_MINUTES=30
ALLOWED_ORIGINS=https://code-names-theta.vercel.app,http://localhost:5173
ALLOWED_ORIGIN_REGEX=
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/postgres
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:
# Docker Compose uses the service hostname `redis`; managed hosts such as Render
# must override these URLs with the provider host, port, password, and TLS scheme.
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
REDIS_RECONNECT_INTERVAL_SECONDS=5
REDIS_STARTUP_RETRIES=3
REDIS_STARTUP_RETRY_DELAY_SECONDS=1
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_REDIRECT_URL=https://your-domain.example/api/auth/google/callback
FRONTEND_URL=https://code-names-theta.vercel.app
AVATARS_BUCKET=avatars
WORD_PACKS_BUCKET=word_packs
COOKIE_SECURE=true
COOKIE_DOMAIN=
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
WS_HEARTBEAT_SECONDS=30
WS_DEAD_SECONDS=90
ROOM_RECONNECT_GRACE_SECONDS=30
DEFAULT_TURN_SECONDS=90
LOG_LEVEL=INFO
