# backend/.env.example
APP_NAME="Codenames India API"
APP_ENV=development
DEBUG=true
API_PREFIX=/api
SECRET_KEY=change-me-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_MINUTES=30
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/postgres
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_REDIRECT_URL=http://localhost:8000/api/auth/google/callback
AVATARS_BUCKET=avatars
WORD_PACKS_BUCKET=word_packs
COOKIE_SECURE=false
COOKIE_DOMAIN=
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
WS_HEARTBEAT_SECONDS=30
WS_DEAD_SECONDS=90
ROOM_RECONNECT_GRACE_SECONDS=30
DEFAULT_TURN_SECONDS=90
LOG_LEVEL=INFO
